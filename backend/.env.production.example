# =============================================================================
# AI_AMOOZ – Production Environment Variables
# =============================================================================
# Copy this file to backend/.env and fill in all REQUIRED values.
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# =============================================================================

# ─── Django (REQUIRED) ───
DEBUG=False
DJANGO_SECRET_KEY=CHANGE-ME-TO-A-RANDOM-SECRET-KEY
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ─── Database (REQUIRED) ───
# In docker-compose.prod.yml these are overridden; set them for non-Docker deploys.
DATABASE_URL=postgresql://ai_amooz:STRONG_DB_PASSWORD@postgres:5432/ai_amooz

# ─── Redis / Celery ───
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CHAT_REDIS_URL=redis://redis:6379/0

# ─── AI / LLM APIs (REQUIRED) ───
AVALAI_API_KEY=your-avalai-api-key
AVALAI_BASE_URL=https://api.avalai.ir
GEMINI_API_KEY=your-gemini-api-key
MODEL_NAME=models/gemini-2.5-flash
TRANSCRIPTION_MODEL=models/gemini-2.5-flash
REWRITE_MODEL=models/gemini-2.5-flash
IMAGE_MODEL=models/gemini-3-pro-image-preview
EMBEDDING_MODEL_NAME=models/gemini-embedding-001
MODE=avalai
GENAI_HTTP_TIMEOUT=1000

# ─── Exam Prep current page-first pipeline ───
# Temporary rollback switch. Phase 4 removes it after legacy jobs are drained.
EXAM_PREP_SIMPLE_PIPELINE_ENABLED=True
# Falls back to PDF_VISION_MODEL, then MODEL_NAME when omitted.
EXAM_PREP_PAGE_MODEL=gemini-2.5-flash
EXAM_PREP_PAGE_TIMEOUT_SECONDS=180
EXAM_PREP_PAGE_MAX_OUTPUT_TOKENS=12000
EXAM_PREP_PAGE_MAX_IMAGE_BYTES=10485760
# Dense Persian exam pages use a higher render than the generic PDF pipeline.
EXAM_PREP_RENDER_DPI=200
EXAM_PREP_RENDER_MAX_IMAGE_MB=6
# Native PDF text is supplied as evidence beside the rendered page image.
EXAM_PREP_PAGE_NATIVE_TEXT_MAX_CHARS=30000
# A schema-valid but semantically broken page receives one fresh source pass.
EXAM_PREP_PAGE_QUALITY_REPAIR_ATTEMPTS=1
EXAM_PREP_PAGE_REPAIR_ATTEMPTS=1
EXAM_PREP_PAGE_EXTRACTION_ATTEMPTS=2
EXAM_PREP_TASK_MAX_RETRIES=2
EXAM_PREP_TASK_SOFT_LIMIT_SECONDS=3300
EXAM_PREP_TASK_HARD_LIMIT_SECONDS=3600

# ─── Legacy Exam Prep V4 rollback path ───
# Kept only for existing V4 drafts and temporary rollback during Phase 3/4.
EXAM_PREP_V4_ENABLED=True
EXAM_PREP_V4_CLASSIFICATION_MODEL=gemini-2.5-flash
EXAM_PREP_V4_BLOCK_MODEL=gemini-2.5-flash
EXAM_PREP_V4_QUESTION_MODEL=gemini-2.5-flash
EXAM_PREP_V4_ANSWER_MODEL=gemini-2.5-flash
EXAM_PREP_V4_EXTRACTION_TIMEOUT_SECONDS=180
EXAM_PREP_V4_EXTRACTION_MAX_RETRIES=2
EXAM_PREP_V4_TASK_SOFT_LIMIT_SECONDS=3300
EXAM_PREP_V4_TASK_HARD_LIMIT_SECONDS=3600
EXAM_PREP_V4_STALE_RUN_MINUTES=120
EXAM_PREP_V4_EXTRACTION_BATCH_MAX_BLOCKS=4
EXAM_PREP_V4_EXTRACTION_BATCH_MAX_IMAGES=12
EXAM_PREP_V4_EXTRACTION_BATCH_MAX_BYTES=12582912
EXAM_PREP_V4_QUESTION_BATCH_MAX_OUTPUT_TOKENS=24000
EXAM_PREP_V4_ANSWER_BATCH_MAX_OUTPUT_TOKENS=32000
EXAM_PREP_V4_OCR_EVIDENCE_ENABLED=False
EXAM_PREP_V4_OCR_EVIDENCE_MODEL=mistral-ocr-4-0
EXAM_PREP_V4_OCR_EVIDENCE_MAX_ATTEMPTS=2
EXAM_PREP_V4_OCR_EVIDENCE_RETRY_BACKOFF_SECONDS=0.25
EXAM_PREP_V4_OCR_EVIDENCE_MIN_CONFIDENCE=0.65
EXAM_PREP_V4_OCR_EVIDENCE_BBOX_FOR_DIAGRAMS=True
# Optional V4 geometry prepass. Keep the safe default below until the two-PDF
# smoke test is reviewed; activate it only together with the source-aware route.
EXAM_PREP_V4_SOURCE_FIRST_ENABLED=False

# Production source-aware rollout (explicit opt-in; do not set only one flag):
# EXAM_PREP_SIMPLE_PIPELINE_ENABLED=False
# EXAM_PREP_V4_SOURCE_FIRST_ENABLED=True

# ─── Source-first OCR4 limits ───
# The same bounded values are used by the opt-in V4 geometry prepass and the
# private extraction command. OCR4 text is derived evidence; source crops stay
# authoritative and the existing structured model remains semantic authority.
EXAM_PREP_SOURCE_FIRST_MODEL=mistral-ocr-4-0
EXAM_PREP_SOURCE_FIRST_MAX_PAGES_PER_REQUEST=30
EXAM_PREP_SOURCE_FIRST_MAX_CHUNK_BYTES=29360128
EXAM_PREP_SOURCE_FIRST_MAX_RESPONSE_BYTES=125829120
EXAM_PREP_SOURCE_FIRST_TIMEOUT_SECONDS=600
EXAM_PREP_SOURCE_FIRST_MAX_ATTEMPTS=1
EXAM_PREP_SOURCE_FIRST_WORD_CONFIDENCE=1

# Content-free pipeline logs.
LOG_LEVEL=INFO
LOG_HTTP=True
LOG_SQL=False

# ─── Transcription ───
# Long media is transcribed chunk-by-chunk (audio split into sequential mp3
# segments; each request carries its own time window's frames).
TRANSCRIPTION_CHUNK_SECONDS=600
TRANSCRIPTION_FRAMES_PER_CHUNK=8
TRANSCRIPTION_MAX_DURATION_SECONDS=14400
TRANSCRIPTION_FORCE_CHUNK_MB=80
TRANSCRIPTION_SINGLE_MAX_AUDIO_MB=12
FRAME_MAX_FRAMES_FOR_MODEL=40
FRAME_HARD_CAP=16
FRAME_MAX_WIDTH=960
MAX_TOTAL_FRAME_BYTES_MB=3
FRAME_EXTRACTION_FPS=0.25

# ─── SMS (Mediana) (REQUIRED for student notifications) ───
MEDIANA_API_KEY=your-mediana-api-key

# ─── Pipeline ───
CLASS_PIPELINE_ASYNC=True
# Wall-time budget of the heavy media-ingest tasks (seconds). Must stay >= the
# worst case implied by TRANSCRIPTION_MAX_DURATION_SECONDS.
PIPELINE_TASK_SOFT_TIME_LIMIT=12600
PIPELINE_TASK_TIME_LIMIT=14400

# ─── CORS / CSRF (REQUIRED — set to your frontend domain) ───
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ─── Security (production defaults — override only if needed) ───
# SECURE_SSL_REDIRECT=False — K8s ingress handles SSL. Leave False.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# ─── S3 / MinIO (Object Storage – REQUIRED) ───
# Both backend and celery-worker pods MUST have these env vars.
# Deploy MinIO as a separate Hamravesh app, then create a bucket.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=CHANGE-ME-TO-STRONG-PASSWORD
AWS_STORAGE_BUCKET_NAME=ai-amooz-media
AWS_S3_ENDPOINT_URL=http://minio-service-address:9000
AWS_QUERYSTRING_AUTH=True

# ─── Gunicorn ───
PORT=8000
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=300
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=4
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50

# ─── Throttle ───
THROTTLE_RATE_ANON=30/minute
THROTTLE_RATE_USER=200/minute

# ─── Upload Limits ───
MAX_UPLOAD_MB=500
TRANSCRIPTION_MAX_UPLOAD_MB=500
