# ─── Django ───
DEBUG=True
DJANGO_SECRET_KEY=<LOCAL_DJANGO_SECRET_KEY>
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://ai_amooz:<LOCAL_DB_PASSWORD>@localhost:5432/ai_amooz

# ─── Redis / Celery ───
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CHAT_REDIS_URL=redis://localhost:6379/0

# ─── AI / LLM APIs ───
AVALAI_API_KEY=<AVALAI_API_KEY>
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_OCR_ENDPOINT=https://api.avalai.ir/v1/ocr
GEMINI_API_KEY=<GEMINI_API_KEY>
MODEL_NAME=models/gemini-2.5-flash
TRANSCRIPTION_MODEL=models/gemini-2.5-flash
REWRITE_MODEL=models/gemini-2.5-flash
IMAGE_MODEL=models/gemini-3-pro-image-preview
EMBEDDING_MODEL_NAME=models/gemini-embedding-001
MODE=avalai
GENAI_HTTP_TIMEOUT=1000

# ─── Exam Prep Mistral production pipeline ───
# Standard intake is fixed to OCR4 -> deterministic Stage 2 -> source-precise
# Stage 3 -> free deterministic Stage 4 -> all-region Stage 5. No page-first/V4
# runtime switch is supported by the public endpoint.
EXAM_PREP_MISTRAL_OCR_MODEL=mistral-ocr-4-0
EXAM_PREP_MISTRAL_OCR_MAX_PAGES_PER_REQUEST=30
EXAM_PREP_MISTRAL_OCR_MAX_CHUNK_BYTES=29360128
EXAM_PREP_MISTRAL_OCR_MAX_RESPONSE_BYTES=125829120
EXAM_PREP_MISTRAL_OCR_TIMEOUT_SECONDS=600
EXAM_PREP_MISTRAL_OCR_MAX_ATTEMPTS=2
EXAM_PREP_MISTRAL_OCR_CHECKPOINTS=True
EXAM_PREP_STAGE4_RISK_THRESHOLD=40
EXAM_PREP_STAGE5_PRIMARY_MODEL=gpt-5.4-mini
EXAM_PREP_STAGE5_MAIN_MODEL=gemini-3.6-flash
EXAM_PREP_STAGE5_TIEBREAKER_MODEL=
EXAM_PREP_STAGE5_MAX_PRIMARY_CALLS=400
EXAM_PREP_STAGE5_MAX_MAIN_CALLS=40
EXAM_PREP_STAGE5_MAX_CONCURRENCY=4
EXAM_PREP_STAGE5_PRIMARY_TIMEOUT_SECONDS=60
EXAM_PREP_STAGE5_MAIN_TIMEOUT_SECONDS=120
EXAM_PREP_STAGE5_MAX_OUTPUT_TOKENS=2500
EXAM_PREP_STAGE5_MAX_WALL_SECONDS=1800
# Stage 5 reserves this conservative input allowance before each paid call.
EXAM_PREP_STAGE5_RESERVED_INPUT_TOKENS=8192
# Remaining budget after OCR is a hard rolling Stage-5 submission gate.
EXAM_PREP_TOTAL_PDF_BUDGET_USD=1.50
EXAM_PREP_STAGE5_MINIMUM_RESERVE_USD=0.75
EXAM_PREP_TARGETED_OCR_RESERVE_PER_PAGE_USD=0.0065
EXAM_PREP_TASK_MAX_RETRIES=2
EXAM_PREP_TASK_SOFT_LIMIT_SECONDS=3300
EXAM_PREP_TASK_HARD_LIMIT_SECONDS=3600
EXAM_PREP_TASK_FINALIZE_SAFETY_SECONDS=300

# ─── Transcription ───
# Long media is transcribed chunk-by-chunk (audio split into sequential mp3
# segments; each request carries its own time window's frames).
TRANSCRIPTION_CHUNK_SECONDS=600
TRANSCRIPTION_FRAMES_PER_CHUNK=8
TRANSCRIPTION_MAX_DURATION_SECONDS=14400
TRANSCRIPTION_FORCE_CHUNK_MB=80
TRANSCRIPTION_SINGLE_MAX_AUDIO_MB=12
FRAME_MAX_FRAMES_FOR_MODEL=40
FRAME_HARD_CAP=16
FRAME_MAX_WIDTH=960
MAX_TOTAL_FRAME_BYTES_MB=3
FRAME_EXTRACTION_FPS=0.25

# ─── SMS (Mediana) ───
MEDIANA_API_KEY=<MEDIANA_API_KEY>

# ─── Pipeline ───
CLASS_PIPELINE_ASYNC=True
# Interactive handwriting OCR preview. Keep disabled until migrations, backend,
# the dedicated interactive worker, and frontend are deployed together.
EXERCISE_ANSWER_OCR_PREVIEW_ENABLED=False
EXERCISE_ANSWER_OCR_MAX_PAGES=20
EXERCISE_ANSWER_OCR_MAX_BYTES=31457280
EXERCISE_ANSWER_OCR_REQUEST_MAX_BYTES=33554432
EXERCISE_ANSWER_OCR_MAX_PAGES_PER_HOUR=60
EXERCISE_ANSWER_OCR_MAX_BYTES_PER_HOUR=134217728
EXERCISE_ANSWER_OCR_PAGES_PER_CALL=4
EXERCISE_ANSWER_OCR_SETTLE_SECONDS=2
EXERCISE_ANSWER_OCR_TIMEOUT_SECONDS=180
EXERCISE_ANSWER_OCR_SOFT_TIME_LIMIT=2400
EXERCISE_ANSWER_OCR_TIME_LIMIT=2700
EXERCISE_ANSWER_OCR_IMAGE_MAX_BYTES=3145728
EXERCISE_ANSWER_OCR_IMAGE_MAX_DIMENSION=2400
EXERCISE_ANSWER_OCR_IMAGE_MAX_PIXELS=30000000
EXERCISE_ANSWER_OCR_ASSET_RETENTION_DAYS=30
THROTTLE_RATE_ANSWER_OCR_UPLOAD=12/hour
# EXERCISE_ANSWER_OCR_MODEL=          # fallback: EXERCISE_VISION_MODEL/IMAGE_MODEL
# EXERCISE_ANSWER_MAPPING_MODEL=      # fallback: OCR/vision model
# Wall-time budget of the heavy media-ingest tasks (seconds). Must stay >= the
# worst case implied by TRANSCRIPTION_MAX_DURATION_SECONDS.
PIPELINE_TASK_SOFT_TIME_LIMIT=12600
PIPELINE_TASK_TIME_LIMIT=14400

# ─── PDF ingestion (Step 1 alternative to media) — LLM-only extraction ───
PDF_MAX_UPLOAD_MB=100
PDF_MAX_PAGES=200
# Page render resolution sent to the vision model (lower = fewer image tokens).
PDF_RENDER_DPI=150
PDF_EXTRACTION_CONCURRENCY=2
PDF_MAX_IMAGE_BYTES_MB=3
# Skip blank pages (no text/figures, near-uniform render) — saves an LLM call.
PDF_SKIP_BLANK_PAGES=True
PDF_BLANK_STD_THRESHOLD=3.0
# Embedded-figure filters: ignore images smaller than these (decorative icons).
PDF_IMAGE_MIN_PX=64
PDF_IMAGE_MIN_BYTES=1024
# Override the vision model (else falls back to MODEL_NAME). Must be multimodal.
# PDF_VISION_MODEL=gemini-2.5-flash
# Deprecated (LLM-only no longer routes on the text layer); kept for back-compat.
PDF_TEXT_LAYER_MIN_CHARS=80
PDF_FORCE_VISION=False

# ─── Legacy Exam-prep V2/V3 (not the public production intake) ───
EXAM_PREP_EXTRACTION_V2=False
# Optional; falls back to STRUCTURE_MODEL, REWRITE_MODEL, then MODEL_NAME.
# EXAM_PREP_STRUCTURE_MODEL=gemini-2.5-flash
EXAM_PREP_INVENTORY_CHUNK_CHARS=16000
# Optional multimodal analysis override; falls back to PDF_VISION_MODEL then the
# selected exam-prep structure model.
# EXAM_PREP_VISUAL_ANALYSIS_MODEL=gemini-2.5-flash
EXAM_PREP_IMAGE_GENERATION_ENABLED=False
EXAM_PREP_IMAGE_GENERATION_MODEL=gemini-3.1-flash-lite-image

# ─── Legacy Exam-prep quality-gated extraction V3 ───
# Freeze V3 only for sessions created after this value is enabled. Existing
# sessions continue with the pipeline_version stored in their artifact.
EXAM_PREP_EXTRACTION_VERSION=1
EXAM_PREP_REQUIRE_TEACHER_REVIEW=True
EXAM_PREP_SOURCE_RETENTION_DAYS=7
PDF_OCR_MAX_OUTPUT_CHARS_PER_PAGE=24000
PDF_OCR_MAX_OUTPUT_TOKENS=16000
PDF_OCR_NATIVE_RATIO_LIMIT=3
PDF_OCR_ROBUST_Z_LIMIT=8
PDF_OCR_DUPLICATE_LINE_RATIO_LIMIT=0.35
PDF_OCR_MAX_ATTEMPTS=2
LLM_PROVIDER_MAX_CONCURRENCY=8

# ─── CORS / CSRF ───
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:9002
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── S3 / MinIO (Object Storage) ───
# Set AWS_STORAGE_BUCKET_NAME to enable S3 storage; leave blank for local filesystem.
AWS_ACCESS_KEY_ID=<LOCAL_S3_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<LOCAL_S3_SECRET_ACCESS_KEY>
AWS_STORAGE_BUCKET_NAME=ai-amooz-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_QUERYSTRING_AUTH=False

# ─── Gunicorn ───
PORT=8000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=300
GUNICORN_WORKER_CLASS=sync

# ─── Throttle ───
THROTTLE_RATE_ANON=60/minute
THROTTLE_RATE_USER=300/minute
# Public waitlist intake (teacher/org access requests) — abuse-prone, per IP.
THROTTLE_RATE_WAITLIST=10/hour
# Per-endpoint brute-force limits on credential / account-creation endpoints (per IP).
THROTTLE_RATE_LOGIN=10/min
THROTTLE_RATE_INVITE_LOGIN=10/min
THROTTLE_RATE_REGISTER=10/hour
THROTTLE_RATE_REDEEM=15/hour
THROTTLE_RATE_PASSWORD_RESET=15/hour

# Password-reset OTP (SMS) — code lifetime in seconds.
PASSWORD_RESET_OTP_TTL_SECONDS=600

# ─── Waitlist ───
# Frontend origin used to build the teacher registration link sent by SMS on
# approval, e.g. https://app.example.com → .../register/complete?token=...
# If unset, the SMS includes the raw token instead of a clickable link.
FRONTEND_BASE_URL=

# ─── JWT / session length ───
# Access token = short-lived working credential (silently refreshed). Refresh
# token = the session window: how long a user can be away and still return
# without re-logging-in (rotation gives active users a rolling window).
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=3

# Refresh-token HttpOnly cookie (frontend calls auth via the same-origin /api
# proxy so SameSite=Lax host-only cookies work). Master switch lets ops disable
# without a redeploy. SECURE defaults to True unless DEBUG.
AUTH_REFRESH_COOKIE=True
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/
# AUTH_REFRESH_COOKIE_SECURE=True   # auto: False in DEBUG, True otherwise

# ─── Upload Limits ───
MAX_UPLOAD_MB=500
TRANSCRIPTION_MAX_UPLOAD_MB=500
