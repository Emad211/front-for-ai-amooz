{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/types/**/*.d.ts",
    "src/features/exam-prep-v4/**/*.ts",
    "src/services/exam-prep-v4-service.ts",
    "src/services/exam-prep-v4-review-service.ts",
    "src/services/exam-prep-v4-projection-service.ts",
    "src/services/exam-prep-source-aware-service.ts",
    "src/hooks/use-exam-prep-v4-*.ts",
    "src/components/teacher/exam-prep-v4/**/*.tsx",
    "src/components/teacher/create-class/exam-prep-source-aware-workspace.tsx",
    "src/components/teacher/create-class/pipeline-tracker.tsx",
    "src/components/teacher/create-class/file-upload-section.tsx",
    "src/app/(teacher)/teacher/exam-prep-v4/**/*.tsx",
    "src/constants/navigation.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
